global
  maxconn 4096

defaults
  mode tcp
  timeout connect 10s
  timeout client 1m
  timeout server 1m

frontend mysql_front
  bind *:3308
  default_backend galera_cluster

backend galera_cluster
  balance roundrobin
  option mysql-check user haproxy_check
  default-server inter 3s fall 3 rise 2 on-marked-down shutdown-sessions
  server galera1 galera1:3306 check
  server galera2 galera2:3306 check
  server galera3 galera3:3306 check
  server galera4 galera4:3306 check
  server galera5 galera5:3306 check

listen stats
  bind *:8404
  mode http
  stats enable
  stats uri /
  stats refresh 5s
